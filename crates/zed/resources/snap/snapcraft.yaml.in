name: zaseo
title: Zaseo
base: core24
version: "$RELEASE_VERSION"
summary: A local code editor based on Zed
description: |
  Zaseo is a code editor fork based on Zed, with local Paseo integration.
grade: stable
confinement: classic
compression: lzo
parts:
  zaseo:
    plugin: dump
    source: "../target/release/zaseo-linux-x86_64.tar.gz"

    organize:
      # These renames seem to not be necessary, but it's tidier.
      bin: usr/bin
      libexec: usr/libexec

    stage-packages:
      - libasound2t64
      # snapcraft has a lint that this is unused, but without it Zaseo may exit with
      # "Missing Vulkan entry points: LibraryLoadFailure" in wgpu.
      - libvulkan1
      # snapcraft has a lint that this is unused, but without it Zaseo may exit with
      # "NoWaylandLib" when run with Wayland.
      - libwayland-client0
      - libxcb1
      - libxkbcommon-x11-0
      - libxkbcommon0

    build-attributes:
      - enable-patchelf

    prime:
      # Omit unneeded files from the tarball
      - -lib
      - -licenses.md
      - -share

      # Omit unneeded files from stage-packages
      - -etc
      - -usr/share/doc
      - -usr/share/lintian
      - -usr/share/man

apps:
  zaseo:
    command: usr/bin/zaseo
    common-id: local.zaseo.Zaseo
    environment:
      ZED_BUNDLE_TYPE: snap
