#!/usr/bin/env bash

set -euxo pipefail
source script/lib/blob-store.sh

# Function for displaying help info
help_info() {
  echo "
Usage: ${0##*/} [options]
Build a release .tar.gz for Linux.

Options:
  -h, --help     Display this help and exit.
  --flatpak      Set ZED_BUNDLE_TYPE=flatpak so that this can be included in system info
  "
}

# Parse all arguments manually
while [[ $# -gt 0 ]]; do
    case $1 in
        -h|--help)
            help_info
            exit 0
            ;;
        --flatpak)
            export ZED_BUNDLE_TYPE=flatpak
            shift
            ;;
        --)
            shift
            break
            ;;
        -*)
            echo "Unknown option: $1" >&2
            help_info
            exit 1
            ;;
        *)
            echo "Error: Unexpected argument: $1" >&2
            help_info
            exit 1
            ;;
    esac
done

if [[ -n "${RUSTFLAGS+x}" || -n "${CARGO_ENCODED_RUSTFLAGS+x}" ]]; then
    echo "Unset RUSTFLAGS and CARGO_ENCODED_RUSTFLAGS; put extra flags in target rustflags in .cargo/config.toml so bundle flags are preserved." >&2
    exit 1
fi

export ZED_BUNDLE=true

channel=$(<crates/zed/RELEASE_CHANNEL)
target_dir="${CARGO_TARGET_DIR:-target}"

version="$(script/get-crate-version zed)"
# Set RELEASE_VERSION so it's compiled into GPUI and it knows about the version.
export RELEASE_VERSION="${version}"

commit=$(git rev-parse HEAD | cut -c 1-7)

version_info=$(rustc --version --verbose)
host_line=$(echo "$version_info" | grep host)
target_triple=${host_line#*: }

# Generate the licenses first, so they can be baked into the binaries
script/generate-licenses

export CC=${CC:-$(which clang)}

# Build binary in release mode
cargo --config .cargo/bundle-config.toml build --release --target "${target_triple}" --package zed --package cli

# Split debug symbols into local .dbg files, then strip debug info and local
# symbols from the shipped binaries. The .dbg files keep symbols recoverable.
# We use llvm-objcopy because GNU objcopy on older distros (e.g. Ubuntu 20.04)
# doesn't understand CREL sections produced by newer LLVM.
llvm-objcopy --only-keep-debug "${target_dir}/${target_triple}/release/zaseo" "${target_dir}/${target_triple}/release/zaseo.dbg"
llvm-objcopy --strip-debug --discard-all "${target_dir}/${target_triple}/release/zaseo"
llvm-objcopy --strip-debug --discard-all "${target_dir}/${target_triple}/release/cli"

suffix=""
if [ "$channel" != "stable" ]; then
  suffix="-$channel"
fi

# Move everything that should end up in the final package
# into a temp directory.
temp_dir=$(mktemp -d)
zaseo_dir="${temp_dir}/zaseo$suffix.app"

# Binary
mkdir -p "${zaseo_dir}/bin" "${zaseo_dir}/libexec"
cp "${target_dir}/${target_triple}/release/zaseo" "${zaseo_dir}/libexec/zaseo-editor"
cp "${target_dir}/${target_triple}/release/cli" "${zaseo_dir}/bin/zaseo"

# Libs
# Bundle libstdc++ so older supported systems can run binaries built with our
# toolchain even when their system libstdc++.so.6 lacks required GLIBCXX symbols.
#
# Never bundle the GLib family or its private dependencies: host libraries that
# get dlopen'd are built against the system GLib, and resolving them against an
# older bundled copy fails with missing symbols.
find_libs() {
    ldd ${target_dir}/${target_triple}/release/zaseo |\
        cut -d' ' -f3 |\
        grep -v '\<\(libc.so\|libgcc_s.so\|libm.so\|libpthread.so\|libdl.so\|libasound.so\)' |\
        grep -v '\<\(libglib-2.0.so\|libgobject-2.0.so\|libgio-2.0.so\|libgmodule-2.0.so\|libpcre.so\|libpcre2-8.so\|libmount.so\|libblkid.so\|libselinux.so\|libffi.so\|libresolv.so\|libz.so\)'
}

mkdir -p "${zaseo_dir}/lib"
rm -rf "${zaseo_dir}/lib/*"
cp $(find_libs) "${zaseo_dir}/lib"

# Icons
mkdir -p "${zaseo_dir}/share/icons/hicolor/512x512/apps"
cp "crates/zed/resources/app-icon$suffix.png" "${zaseo_dir}/share/icons/hicolor/512x512/apps/zaseo$suffix.png"
mkdir -p "${zaseo_dir}/share/icons/hicolor/1024x1024/apps"
cp "crates/zed/resources/app-icon$suffix@2x.png" "${zaseo_dir}/share/icons/hicolor/1024x1024/apps/zaseo$suffix.png"

# .desktop
export DO_STARTUP_NOTIFY="true"
export APP_CLI="zaseo"
export APP_ICON="zaseo$suffix"
export APP_ARGS="%U"
if [[ "$channel" == "preview" ]]; then
  export APP_NAME="Zaseo Preview"
  APP_ID="local.zaseo.Zaseo-Preview"
elif [[ "$channel" == "nightly" ]]; then
  export APP_NAME="Zaseo Nightly"
  APP_ID="local.zaseo.Zaseo-Nightly"
elif [[ "$channel" == "dev" ]]; then
  export APP_NAME="Zaseo Dev"
  APP_ID="local.zaseo.Zaseo-Dev"
else
  export APP_NAME="Zaseo"
  APP_ID="local.zaseo.Zaseo"
fi

mkdir -p "${zaseo_dir}/share/applications"
envsubst < "crates/zed/resources/zed.desktop.in" > "${zaseo_dir}/share/applications/$APP_ID.desktop"
chmod +x "${zaseo_dir}/share/applications/$APP_ID.desktop"

# Copy generated licenses so they'll end up in archive too
cp "assets/licenses.md" "${zaseo_dir}/licenses.md"

# Create archive out of everything that's in the temp directory
arch=$(uname -m)
archive="zaseo-linux-${arch}.tar.gz"

rm -rf "${archive}"
remove_match="zaseo(-[a-zA-Z0-9]+)?-linux-$(uname -m)\.tar\.gz"
ls "${target_dir}/release" | grep -E ${remove_match} | xargs -d "\n" -I {} rm -f "${target_dir}/release/{}" || true
tar -czvf "${target_dir}/release/$archive" -C ${temp_dir} "zaseo$suffix.app"
